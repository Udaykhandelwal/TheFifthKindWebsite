{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/Video/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(favicon.ico|icon.svg|icon-192.png|icon-512.png|apple-touch-icon.png|og-image.jpg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(llms.txt|robots.txt|sitemap.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/services",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/#contact",
      "permanent": true
    },
    {
      "source": "/chatbot",
      "destination": "/ai-chatbot-development/",
      "permanent": true
    },
    {
      "source": "/automation",
      "destination": "/ai-automation-agency/",
      "permanent": true
    },
    {
      "source": "/whatsapp",
      "destination": "/whatsapp-chatbot/",
      "permanent": true
    },
    {
      "source": "/voice",
      "destination": "/ai-automation-agency/",
      "permanent": true
    },
    {
      "source": "/ai-voice-agent",
      "destination": "/ai-automation-agency/",
      "permanent": true
    },
    {
      "source": "/ai-voice-agent/",
      "destination": "/ai-automation-agency/",
      "permanent": true
    },
    {
      "source": "/blog/ai-voice-agent-india-guide",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/blog/ai-voice-agent-india-guide/",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/jewelry",
      "destination": "/jewellery/",
      "permanent": true
    },
    {
      "source": "/jewelry/",
      "destination": "/jewellery/",
      "permanent": true
    }
  ]
}
